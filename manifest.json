{
  "manifest_version": 3,
  "name": "Sound / Script",
  "version": "1.1.0",
  "description": "Turn the current webpage into Sound / Script with one click. Refresh to undo.",
  "action": {
    "default_title": "Encode this page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}